# Copy this file to .env and fill in real values. Never commit .env.

# Base URL used when generating short links (change for production)
BASE_URL=http://127.0.0.1:8000

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///./data/app.db

# Session secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_64_char_hex_string

# Admin login credentials for the dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Length of auto-generated short codes
SHORTCODE_LENGTH=6
